     state_size = -4000,
     spawned_state_size = -4000,         

     },
     reference = {
        ex_level = 2,
     },
     uccmc = {
        trotterized = true,
        average_wfn = true,
     },
     ccmc = {
        full_non_composite = true,
     }
    }
